# Copia este archivo como .env (cp .env.example .env). El .env NO se sube a Git.
# Estas variables las lee docker-compose.yml; todas tienen un valor por defecto.

# --- Base de datos (contenedor db) ---
POSTGRES_USER=app
POSTGRES_PASSWORD=app_password
POSTGRES_DB=walking_skeleton

# --- Puertos publicados en tu máquina (cámbialos si ya están ocupados) ---
# DB_PORT es el puerto de TU máquina hacia el contenedor db; dentro de Docker la API siempre usa 5432.
DB_PORT=5432
API_PORT=3000
WEB_PORT=5173

# Poner en true si el hot-reload del frontend no detecta cambios
# (típico en Docker Desktop con Windows/macOS).
WATCH_POLLING=false
